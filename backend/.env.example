NODE_ENV=development
PORT=3000

# Meta WhatsApp Cloud API Configuration (Test Account)
WHATSAPP_API_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=1272717865934207
WHATSAPP_BUSINESS_ACCOUNT_ID=1633948435034571
TEST_WHATSAPP_DISPLAY_NUMBER=+1 (555) 632-5494
WHATSAPP_ACCESS_TOKEN=

# ==============================================================================
# Meta Webhook Security Configuration (Required in Production)
# ==============================================================================
# Meta App Secret from Meta App Dashboard > App Settings > Basic > App Secret.
# Required in production. Webhooks fail closed with HTTP 403 when missing or invalid.
# NEVER log or commit this secret. Configure securely in Render environment settings.
META_APP_SECRET=

# Webhook Verification Token.
# In production, a custom cryptographically secure random string is REQUIRED.
# Must match the Verify Token configured in Meta Developer Dashboard > WhatsApp > Configuration > Webhook.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Predictable defaults (e.g. glowblast_webhook_verify_token) are strictly rejected in production.
META_VERIFY_TOKEN=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN is also supported as an alias for META_VERIFY_TOKEN.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Allowed CORS origins (* for dev, or specific URLs, comma-separated in production)
CORS_ALLOWED_ORIGINS=*

BACKEND_BASE_URL=http://localhost:3000

# Enforce Meta developer test mode recipient limit (maximum 5)
TEST_RECIPIENT_LIMIT=5

TEST_CAMPAIGN_ENABLED=true

# Authorized test phone numbers (comma-separated international digits, e.g. 919876543210,919811223344)
TEST_RECIPIENTS=919182769155,917780102610

# ==============================================================================
# Multi-Business WABA Token Encryption (Required for Multi-Tenant SaaS)
# ==============================================================================
# Canonical AES-256-GCM encryption key used to encrypt and decrypt tenant WhatsApp access tokens.
# Cryptographic requirement: Exactly 32 cryptographically secure random bytes.
# Supported formats:
#   - 64-character hexadecimal string
#   - 44-character base64-encoded string
#   - 32-character raw UTF-8 string
# Generate a new secure key using Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configure in Render Environment settings. NEVER commit or expose this key.
WABA_TOKEN_ENCRYPTION_KEY=

# Optional supported alias for backwards compatibility:
# WABA_ENCRYPTION_KEY=

# ==============================================================================
# Transactional Email (Brevo / Sendinblue)
# ==============================================================================
# Required for OTP verification codes and team membership invitations.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=GlowBlast

# ==============================================================================
# Production WhatsApp Account (Single-Business Legacy / Fallback)
# ==============================================================================
PROD_WHATSAPP_PHONE_NUMBER_ID=1436324276220624
PROD_WHATSAPP_BUSINESS_ACCOUNT_ID=3226959717495309
PROD_WHATSAPP_DISPLAY_NUMBER=+919502259203
# The production access token must ONLY be configured in Render's Environment settings.
# NEVER commit or hardcode this token in git or files.
PROD_WHATSAPP_ACCESS_TOKEN=

# Production Safety Controls
ENABLE_PRODUCTION_CAMPAIGNS=false
# Authorized email addresses (comma-separated) allowed to dispatch live campaigns:
PRODUCTION_ALLOWED_EMAILS=
# Maximum unique recipients allowed across all campaigns per rolling 24 hours:
PROD_UNIQUE_RECIPIENTS_PER_24H_LIMIT=200

# ==============================================================================
# Database Configuration (Neon PostgreSQL)
# ==============================================================================
# For local development and testing, set your Neon development branch connection string
# in backend/.env.local (which is excluded from Git):
TEST_DATABASE_URL=

# Production database connection string must ONLY be configured in Render's environment settings.
# NEVER commit or hardcode this in git, .env, or client apps.
# DATABASE_URL=

# ==============================================================================
# Migration-Only Settings (Do NOT use for ongoing authorization)
# ==============================================================================
# When running migration 012 on a database with multiple verified users, set this to the
# email of the existing verified user who will own the initial seeded business.
# The migration runner validates that the user exists and is verified, then sets the
# transaction-local session variable glowblast.initial_owner_email.
# This variable is migration-only and must be removed after migration 012 completes.
INITIAL_BUSINESS_OWNER_EMAIL=
